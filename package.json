{
  "name": "teggle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/build-sw.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engines": "tsx tools/test-engines.ts",
    "test:browsers": "playwright test -c tests/browser/playwright.config.ts",
    "bench:sim": "tsx tools/bench-sim.ts",
    "shots": "tsx tools/screenshot.ts",
    "gen:level": "tsx tools/gen-level.ts",
    "shots:levels": "tsx tools/level-shots.ts",
    "shots:menus": "tsx tools/menu-shots.ts",
    "shots:mobile": "tsx tools/mobile-shots.ts",
    "perf:mobile": "tsx tools/mobile-perf.ts",
    "icons": "tsx tools/app-icons.ts",
    "audio:render": "tsx tools/render-audio.ts",
    "campaign:build": "tsx tools/campaign/build.ts",
    "campaign:art": "tsx tools/campaign/art.ts",
    "campaign:grid": "tsx tools/campaign/grid.ts",
    "campaign:shots": "tsx tools/campaign/shots.ts",
    "agents:report": "tsx tools/agents/report.ts",
    "agents:bands": "tsx tools/agents/bands.ts",
    "agents:calibrate": "tsx tools/agents/calibrate.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
